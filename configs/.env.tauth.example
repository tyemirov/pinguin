# Documentation only: never source, copy, or use this file as runtime configuration.
# Operational values are intentionally goofy and non-operational. Create a private ignored env file.
# Boolean, numeric, and enum entries remain type-valid documentation, not runnable defaults.

TAUTH_TENANT_ID_PINGWIN=goofy-moon-cheese-42
TAUTH_TENANT_DISPLAY_NAME_PINGWIN=Goofy banana helmet
TAUTH_TENANT_ORIGIN_PINGWIN=http://moon-cheese.invalid:4242
TAUTH_TENANT_GOOGLE_WEB_CLIENT_ID_PINGWIN=disco-pickle-42.apps.googleusercontent.com

# Must match TAUTH_SIGNING_KEY in configs/.env.pingwin.
TAUTH_TENANT_JWT_SIGNING_KEY_PINGWIN=4242424242424242424242424242424242424242424242424242424242424242
TAUTH_TENANT_SESSION_COOKIE_NAME_PINGWIN=goofy_tauth_tenant_session_cookie_name_pingwin
TAUTH_TENANT_REFRESH_COOKIE_NAME_PINGWIN=goofy_tauth_tenant_refresh_cookie_name_pingwin

TAUTH_CONFIG_FILE=/tmp/goofy-do-not-use/banana-helmet.yml
TAUTH_LISTEN_ADDR=127.0.0.42:4242
TAUTH_DATABASE_URL=sqlite:///tmp/goofy-do-not-use/tauth-database-url.db
TAUTH_ENABLE_CORS=false
TAUTH_CORS_ORIGIN_1=${TAUTH_TENANT_ORIGIN_PINGWIN}
TAUTH_CORS_EXCEPTION_1=https://waffle-wizard.invalid
TAUTH_ENABLE_TENANT_HEADER_OVERRIDE=false
TAUTH_ALLOW_INSECURE_HTTP=false
TAUTH_COOKIE_DOMAIN=turbo-turnip.invalid
